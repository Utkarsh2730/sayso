# Required: Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: HubSpot private-app token (scopes: crm.objects.contacts.read/write).
# Leave empty to use the built-in local CRM only.
HUBSPOT_TOKEN=
# Minutes it takes you to write up a call by hand; used for the "time saved" stat.
MANUAL_WRITEUP_MINUTES=6
PORT=3000

# Model used for extraction (default claude-opus-5-5)
CLAUDE_MODEL=

